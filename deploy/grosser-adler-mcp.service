[Unit]
Description=Großer Adler independent observer MCP
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/repos/grosser-adler
Environment=GROSSER_ADLER_STATE_ROOT=%h/.local/state/grosser-adler
Environment=GROSSER_ADLER_WORK_LANES_ROOT=%h/.local/state/grabowski/work-lanes
Environment=GROSSER_ADLER_WORKTREE_ROOT=%h/repos/.grabowski-worktrees
EnvironmentFile=-%h/.config/grosser-adler/github.env
ExecStart=%h/repos/grosser-adler/.venv/bin/python %h/repos/grosser-adler/server.py --transport streamable-http --host 127.0.0.1 --port 18186
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=%h/repos %h/.local/state/grabowski/work-lanes
ReadWritePaths=%h/.local/state/grosser-adler %h/repos/.grabowski-worktrees
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=default.target
